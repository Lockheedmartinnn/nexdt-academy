{
  "name": "NexDT Assistant self-test",
  "description": "Maintenance check: runs a fixed set of questions through the assistant and writes the answers to the askAcademy function log.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 0 1 1 *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "do": [
      {
        "test": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {
              "probe": "args"
            },
            "arguments": {
              "probe": "arguments"
            },
            "body": {
              "probe": "body"
            },
            "data": {
              "probe": "data"
            },
            "function_args": {
              "probe": "function_args"
            },
            "function_name": "askAcademy",
            "input": {
              "probe": "input"
            },
            "params": {
              "probe": "params"
            },
            "payload": {
              "probe": "payload"
            }
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "assistant-self-test",
      "namespace": "base44",
      "version": "1.0.1"
    }
  }
}