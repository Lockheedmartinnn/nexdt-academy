{
  "name": "AssistantQuestion",
  "properties": {
    "answer": {
      "description": "What the assistant replied",
      "type": "string"
    },
    "answered": {
      "default": false,
      "description": "Whether the knowledge base contained an answer",
      "type": "boolean"
    },
    "helpful": {
      "description": "User feedback (thumbs up/down)",
      "type": "boolean"
    },
    "page": {
      "description": "App page the question was asked from",
      "type": "string"
    },
    "question": {
      "description": "What the user asked",
      "type": "string"
    },
    "sources": {
      "default": [],
      "description": "Articles cited in the answer",
      "items": {
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "question"
  ],
  "rls": {
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}